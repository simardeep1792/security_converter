# Build stage
FROM rust:latest AS builder

RUN apt-get -qq update && apt-get install -y -q \
    libclang-dev \
    libssl-dev

WORKDIR /app

# Copy workspace configuration and lock file
COPY Cargo.toml Cargo.lock ./

# Copy all workspace members
COPY graphql_api graphql_api
COPY errors errors

# Copy migrations (embedded in database.rs)
COPY migrations migrations

RUN cargo build --release -p graphql_api

# Final stage
FROM debian:bookworm-slim

# Install dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libclang-dev \
    libpq-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Add 'rusty' user/group we wish the container to run as
RUN groupadd -r rusty && useradd --no-log-init -r -g rusty rusty

WORKDIR /app

# Copy the compiled binary with a different name to avoid conflict with graphql_api directory
COPY --from=builder /app/target/release/graphql_api ./server

# templates: needed for rendering web pages
COPY templates templates

# static: needed for javascript and css (app expects it at graphql_api/static due to CARGO_MANIFEST_DIR)
COPY graphql_api/static graphql_api/static

USER rusty
EXPOSE 8080

CMD ["./server"]
